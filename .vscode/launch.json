{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  //
  // AutoBridge has a `mode` flavor dimension (safe / personal / lab) crossed with the
  // debug / release build types, so each APK lands at:
  //   app/build/outputs/apk/<flavor>/<buildType>/app-<flavor>-<buildType>.apk
  // Build the matching variant first, e.g. `./gradlew installSafeDebug` or
  // `./gradlew assembleSafeDebug`, then launch the config with the same flavor.
  "version": "0.2.0",
  "configurations": [
    {
      // Build + install the chosen flavor, wire adb forward tcp:5277, and open
      // the Desktop Head Unit — all through scripts/dhu-run.sh. Pick it from the
      // Run and Debug dropdown and press F5. Start the phone's "head unit server"
      // (Android Auto > three-dot menu) first. Stop the DHU with the red stop
      // button or Ctrl-C in its terminal. See docs/DHU.md.
      "type": "node-terminal",
      "request": "launch",
      "name": "DHU: safe (debug)",
      "command": "scripts/dhu-run.sh safe 720 touch",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "DHU: personal (debug)",
      "command": "scripts/dhu-run.sh personal 720 touch",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "DHU: lab (debug)",
      "command": "scripts/dhu-run.sh lab 720 touch",
      "cwd": "${workspaceFolder}"
    },
    {
      // Already installed; just re-forward and relaunch the DHU (use after the
      // head unit server was restarted on the phone).
      "type": "node-terminal",
      "request": "launch",
      "name": "DHU: safe (no build, reconnect)",
      "command": "scripts/dhu-run.sh --no-build safe 720 touch",
      "cwd": "${workspaceFolder}"
    },
    {
      // One F5 = rebuild latest code -> reinstall -> relaunch (Android has no
      // hot reload, so this is the "see my change" loop). The preLaunchTask runs
      // `./gradlew installSafeDebug` first; swap flavor via the other two below.
      "type": "android",
      "request": "launch",
      "name": "App: safe (build+run)",
      "preLaunchTask": "gradle: installSafeDebug",
      "appSrcRoot": "${workspaceRoot}/app/src/main",
      "apkFile": "${workspaceRoot}/app/build/outputs/apk/safe/debug/app-safe-debug.apk",
      "launchActivity": "dev.autobridge.MainActivity",
      "adbPort": 5037
    },
    {
      "type": "android",
      "request": "launch",
      "name": "App: personal (build+run)",
      "preLaunchTask": "gradle: installPersonalDebug",
      "appSrcRoot": "${workspaceRoot}/app/src/main",
      "apkFile": "${workspaceRoot}/app/build/outputs/apk/personal/debug/app-personal-debug.apk",
      "launchActivity": "dev.autobridge.MainActivity",
      "adbPort": 5037
    },
    {
      "type": "android",
      "request": "launch",
      "name": "App: lab (build+run)",
      "preLaunchTask": "gradle: installLabDebug",
      "appSrcRoot": "${workspaceRoot}/app/src/main",
      "apkFile": "${workspaceRoot}/app/build/outputs/apk/lab/debug/app-lab-debug.apk",
      "launchActivity": "dev.autobridge.MainActivity",
      "adbPort": 5037
    },
    {
      // No build: just reinstall the existing APK and relaunch (faster when you
      // did not change code).
      "type": "android",
      "request": "launch",
      "name": "App: safe (debug)",
      "appSrcRoot": "${workspaceRoot}/app/src/main",
      "apkFile": "${workspaceRoot}/app/build/outputs/apk/safe/debug/app-safe-debug.apk",
      "launchActivity": "dev.autobridge.MainActivity",
      "adbPort": 5037
    },
    {
      "type": "android",
      "request": "launch",
      "name": "App: personal (debug)",
      "appSrcRoot": "${workspaceRoot}/app/src/main",
      "apkFile": "${workspaceRoot}/app/build/outputs/apk/personal/debug/app-personal-debug.apk",
      "launchActivity": "dev.autobridge.MainActivity",
      "adbPort": 5037
    },
    {
      "type": "android",
      "request": "launch",
      "name": "App: lab (debug)",
      "appSrcRoot": "${workspaceRoot}/app/src/main",
      "apkFile": "${workspaceRoot}/app/build/outputs/apk/lab/debug/app-lab-debug.apk",
      "launchActivity": "dev.autobridge.MainActivity",
      "adbPort": 5037
    },
    {
      "type": "android",
      "request": "launch",
      "name": "App: safe (release)",
      "appSrcRoot": "${workspaceRoot}/app/src/main",
      "apkFile": "${workspaceRoot}/app/build/outputs/apk/safe/release/app-safe-release.apk",
      "launchActivity": "dev.autobridge.MainActivity",
      "adbPort": 5037
    },
    {
      "type": "android",
      "request": "attach",
      "name": "Android attach",
      "appSrcRoot": "${workspaceRoot}/app/src/main",
      "adbPort": 5037,
      "processId": "${command:PickAndroidProcess}"
    }
  ]
}