<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <application>
        <!-- Keeps a runtime/browser download and install alive while the user leaves the
             settings screen. Not exported: started only by the engine itself. -->
        <service
            android:name="dev.autobridge.desktop.install.DesktopEngineInstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- "Start on launch" hook: runs when the app process starts; no data, not exported. -->
        <provider
            android:name="dev.autobridge.desktop.DesktopEngineStarter"
            android:authorities="${applicationId}.desktopengine.starter"
            android:exported="false" />
    </application>
</manifest>
