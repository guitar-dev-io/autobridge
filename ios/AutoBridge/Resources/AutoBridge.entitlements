<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      CarPlay audio is a MANAGED entitlement. Apple must grant
      `com.apple.developer.carplay-audio` to this App ID (team V9Q6ZN9L53) before
      the profile can include it. Request it at:
        https://developer.apple.com/contact/carplay/

      Until the grant is approved, keep this entitlement OUT of the dict so the app
      signs and installs on real devices as a normal iPhone app. The phone app runs
      fine without it; only the CarPlay audio scene is unavailable.

      When approved, re-enable by adding back inside <dict>:
        <key>com.apple.developer.carplay-audio</key>
        <true/>
    -->
</dict>
</plist>
