<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Simulator-only. Simulator builds are signed ad hoc without a provisioning profile,
      so the managed CarPlay entitlement can be declared here before Apple grants it.
      That lets the app show up on the Simulator's CarPlay display
      (I/O > External Displays > CarPlay). Device builds keep using
      AutoBridge.entitlements, which leaves it out until the grant is approved.
    -->
    <key>com.apple.developer.carplay-audio</key>
    <true/>
    <!--
      Also Simulator-only: the navigation entitlement is what makes CarPlay hand the app a window
      it can draw in, which is how a real web page shows on the CarPlay screen
      (CarPlaySceneDelegate, "Web pages on the CarPlay screen"). With it the Simulator runs the
      app as a navigation app; the audio home is the grid button on the map screen. Apple grants
      carplay-maps to navigation apps only, so device builds never carry it.
    -->
    <!--
      Simulator only, until Apple grants it (requested 2026-10-13): CarPlay video, so a TV
      channel is presented as video on the CarPlay display (CPPlaybackConfiguration, iOS 26.4).
      The key name is assumed from the other CarPlay keys; confirm it against the grant.
    -->
    <key>com.apple.developer.carplay-video</key>
    <true/>
    <key>com.apple.developer.carplay-maps</key>
    <true/>
</dict>
</plist>
