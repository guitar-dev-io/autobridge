<?xml version="1.0" encoding="utf-8"?>
<!-- Projection route (personal and lab flavors only - see app/build.gradle.kts).

     Android Auto lists a CATEGORY_PROJECTION service as an ordinary, non-navigation app. That is
     what gives the split screen: the app opens in the main area and the active navigation app
     (Google Maps) shrinks into the side panel next to it. The Car App Library route is a
     NAVIGATION app, and Android Auto has only one navigation slot, so that route always replaces
     Maps full screen instead.

     This uses the unofficial Android Auto SDK (app/libs/aauto.aar, the same archive Fermata Auto
     ships). Android Auto only shows such apps when they are sideloaded with "Unknown sources"
     enabled in its developer settings, and Google Play does not accept them, which is why this
     never reaches the safe (Play) flavor.

     exported: Android Auto (gearhead) binds it. CarActivityService accepts only the car host's
     binding protocol; it exposes no data or commands of this app beyond the activity it hosts.

     enabled="false" (every car service in this file): AutoBridge is the one Android Auto entry
     this project lists. The browser, Multi-app and the desktop browser are all reached from inside
     AutoBridge. What only Bridge Web can do is sit in the main area beside Maps (split screen),
     which a template app cannot, so it is not deleted: Settings › Bridge Web on Android Auto lists
     it again for a driver who wants that split. scripts/check-car-entries.py fails CI if any of
     these is declared enabled again. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Duo Screen's pane picker lists every launchable app, which package visibility otherwise
         hides on Android 11+. Sideload flavors only; the Play build has neither the picker nor
         this permission. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application>
        <service
            android:name="dev.autobridge.projection.ProjectionCarService"
            android:enabled="false"
            android:exported="true"
            android:label="Bridge Web"
            android:icon="@mipmap/ic_browser_launcher"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM" />
            </intent-filter>
        </service>

        <!-- The mirror on the projection route. A separate CATEGORY_PROJECTION service because
             Android Auto lists one icon per service, and because this is the only surface in the
             app that gets real MotionEvents from the car display - the Car App Library route only
             ever reports interpreted gestures. See ProjectionMirrorActivity.

             exported: gearhead binds it, same as the browser service above.

             enabled="false": off until switched on in Settings > Bridge Web on Android Auto. With
             a second CATEGORY_PROJECTION service listed (it arrived in 0.4.20), Android Auto stopped
             offering its split screen - Bridge Web in the main area, Maps beside it - which it
             gave through 0.4.17, when Bridge Web was this app's only projection service, as it is
             Fermata's. Off by default puts the app back in that shape. -->
        <service
            android:name="dev.autobridge.projection.ProjectionMirrorCarService"
            android:enabled="false"
            android:exported="true"
            android:label="Bridge Mirror"
            android:icon="@mipmap/ic_launcher"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM" />
            </intent-filter>
        </service>

        <!-- Walks the user through making this sideloaded build visible on Android Auto (installer
             rewrite via root or Shizuku). Not exported: launched only from within the app. -->
        <activity
            android:name="dev.autobridge.projection.ProjectionSetupActivity"
            android:exported="false"
            android:label="AutoBridge on Android Auto" />


        <!-- Phone-side Duo Screen setup: app per pane, pane count, Shizuku status. Not exported:
             reached from the app's own settings list. -->
        <activity android:name="dev.autobridge.projection.DuoScreenSettingsActivity"
            android:exported="false"
            android:label="@string/duo_screen_title"
            android:description="@string/duo_screen_subtitle" />

        <!-- Desktop Browser Engine (Linux Chrome / Brave, :desktopbrowser). Settings and the phone
             viewer are reached only from inside the app. On the car it opens inside AutoBridge (the
             Web card, once a desktop browser is chosen and installed), so its own CarAppService is
             declared disabled and Android Auto lists no "Desktop Browser" entry. -->
        <activity android:name="dev.autobridge.projection.desktop.DesktopBrowserSettingsActivity"
            android:exported="false"
            android:label="@string/settings_desktop_browser" />
        <activity android:name="dev.autobridge.projection.desktop.DesktopBrowserActivity"
            android:exported="false"
            android:label="@string/settings_desktop_browser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustNothing|stateHidden" />
        <!-- The desktop browser as a Multi-app pane: the same viewer, started on a pane's display by
             the shell user (Shizuku) or root (am start on the pane display). exported so that
             launch can reach it; INTERACT_ACROSS_USERS_FULL so nothing else can, as no ordinary
             app holds it (the same guard ShizukuProvider uses in the main manifest). No intent
             filter and no launcher entry: it exists only to be launched by name. -->
        <activity-alias android:name="dev.autobridge.projection.desktop.DesktopBrowserPane"
            android:targetActivity="dev.autobridge.projection.desktop.DesktopBrowserActivity"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <service android:name="dev.autobridge.projection.desktop.DesktopBrowserCarAppService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/desktop_engine_car_label"
            android:icon="@mipmap/ic_browser_launcher"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

    </application>
</manifest>
