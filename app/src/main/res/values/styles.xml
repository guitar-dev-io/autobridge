<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0B0E14</item>
        <item name="android:navigationBarColor">#0B0E14</item>
        <item name="android:colorAccent">#4C7DF0</item>
        <!-- Menus, popups and dialogs in the AutoBridge surface, not Material's grey. -->
        <item name="android:colorBackgroundFloating">#1A202B</item>
        <item name="android:alertDialogTheme">@style/ToolDialogDark</item>
    </style>

    <!--
        The app theme on a light page (Appearance: Light, or System/Auto at day). Picked at runtime
        by AppTheming; its light parent is what gives menus, pickers, spinners and dialogs light
        faces. Colours are the default light palette (ThemeResolver); the accent is applied on top.
    -->
    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#F2F4F8</item>
        <item name="android:navigationBarColor">#F2F4F8</item>
        <item name="android:windowBackground">#F2F4F8</item>
        <item name="android:colorAccent">#1F67C7</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:alertDialogTheme">@style/ToolDialogLight</item>
    </style>

    <!-- The user's accent on an activity's theme (AppTheming): switches, text fields, pickers, progress. -->
    <style name="AccentOverlay.Sky.Dark" parent=""><item name="android:colorAccent">#67A9FF</item></style>
    <style name="AccentOverlay.Sky.Light" parent=""><item name="android:colorAccent">#1F67C7</item></style>
    <style name="AccentOverlay.Teal.Dark" parent=""><item name="android:colorAccent">#5FD0C4</item></style>
    <style name="AccentOverlay.Teal.Light" parent=""><item name="android:colorAccent">#0B7A70</item></style>
    <style name="AccentOverlay.Amber.Dark" parent=""><item name="android:colorAccent">#FFB35C</item></style>
    <style name="AccentOverlay.Amber.Light" parent=""><item name="android:colorAccent">#955800</item></style>
    <style name="AccentOverlay.Violet.Dark" parent=""><item name="android:colorAccent">#A99BF2</item></style>
    <style name="AccentOverlay.Violet.Light" parent=""><item name="android:colorAccent">#5A46C8</item></style>
    <style name="AccentOverlay.Rose.Dark" parent=""><item name="android:colorAccent">#FF8FA3</item></style>
    <style name="AccentOverlay.Rose.Light" parent=""><item name="android:colorAccent">#B02E4A</item></style>
    <style name="AccentOverlay.Lime.Dark" parent=""><item name="android:colorAccent">#9BE08A</item></style>
    <style name="AccentOverlay.Lime.Light" parent=""><item name="android:colorAccent">#3B7629</item></style>

    <!--
        The browser window's two faces, picked at runtime from the Appearance setting
        (BrowserAppearanceStore.activityTheme). What matters beyond the bar colours is
        android:isLightTheme: WebView reads it off the context a WebView is built with to decide
        what to report for the page's prefers-color-scheme, which is why "Light" could not work
        while the browser was pinned to a dark theme. The colours match BrowserTheme's two schemes
        (surfaceContainer for the status bar, surface for the navigation bar) so the system bars
        continue the chrome instead of framing it.
    -->
    <style name="BrowserThemeDark" parent="AppTheme">
        <item name="android:isLightTheme">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#1D2024</item>
        <item name="android:navigationBarColor">#111318</item>
        <item name="android:windowBackground">#111318</item>
    </style>

    <style name="BrowserThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:isLightTheme">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#EDEDF4</item>
        <item name="android:navigationBarColor">#F9F9FF</item>
        <item name="android:windowBackground">#F9F9FF</item>
        <item name="android:colorAccent">#415F91</item>
    </style>

    <!--
        Material 3 brand colours for host-drawn templates (CarColor.PRIMARY / SECONDARY: buttons,
        toggles, accents). Same blue seed as BrowserTheme. The host checks contrast and falls back
        to its own default if a colour is unreadable on its background.
    -->
    <style name="CarAppTheme">
        <item name="carPermissionActivityLayout">@layout/car_permission_background</item>
        <item name="carColorPrimary">#415F91</item>
        <item name="carColorPrimaryDark">#AAC7FF</item>
        <item name="carColorSecondary">#565F71</item>
        <item name="carColorSecondaryDark">#BEC6DC</item>
    </style>
</resources>
