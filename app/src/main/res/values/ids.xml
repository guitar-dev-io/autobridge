<resources>
    <!-- Tag slot used by ImageLoader to detect a recycled ImageView before applying a decode.
         View.setTag(int, Object) requires an application resource id, not an arbitrary int. -->
    <item name="autobridge_image_tag" type="id" />
    <!-- The status line inside a content tile, so a ping result can be written into a page that
         is already on screen instead of rebuilding it (see AutoBridgeDesign.statusLabel). -->
    <item name="autobridge_status_label" type="id" />
    <item name="autobridge_guide_label" type="id" />
    <!-- The small colored dot on a content tile's artwork corner, updated live by setStatus(). -->
    <!-- The ScrollView AutoBridgeDesign.page() builds around its body, so a caller that needs to
         scroll the page programmatically (a letter index, say) can find it after the page is
         built — see AutoBridgeDesign.pageScroll. -->
    <item name="autobridge_page_scroll" type="id" />
    <!-- Tags the root AutoBridgeDesign.page() builds (value: whether it applies the bar insets),
         so AutoBridgeDesign.showPage can tell it is replacing one page with another. -->
    <item name="autobridge_page_root" type="id" />
</resources>
