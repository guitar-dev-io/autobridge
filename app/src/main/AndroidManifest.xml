<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Only so the ACL_CONNECTED broadcast is delivered: from Android 12 it is permission
         protected, and the media auto-start option would otherwise be a switch that does nothing.
         No device is read and nothing is scanned for. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Special permission: granted via ACTION_MANAGE_WRITE_SETTINGS, used only for the
         per-app force-landscape profile (QuickAppLauncher). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Lets the Car setup screen show Android's own "Allow background activity" prompt directly
         instead of sending the user hunting through Settings. Some OEM battery managers
         (MIUI/HyperOS and similar) kill AutoBridge's foreground mirroring/media services anyway
         unless the app is exempted, even though both are declared and started correctly. Optional
         step — mirroring and playback still work without it on stock Android. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android for Cars: development/personal-use POC surface. -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />

    <!-- Optional GPS speed fallback for the speed display (best-value selection: CAR > GPS > OBD).
         Requested at runtime only when the user opts into GPS speed; not required for the app. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Read-only access for the Folders, Playlists and Gallery sections. Requested at runtime
         when the user opens one of those sections; the app works without them otherwise. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- IPTV portals and set-top playlists are overwhelmingly plain http, so cleartext has to be
         permitted for user-entered hosts. The network security config keeps that explicit and
         reviewable instead of hiding it behind a blanket attribute. -->
    <application android:name=".AutoBridgeApplication" android:networkSecurityConfig="@xml/network_security_config" android:allowBackup="true" android:icon="@drawable/ic_autobridge_launcher" android:label="AutoBridge" android:roundIcon="@drawable/ic_autobridge_launcher" android:supportsRtl="true" android:theme="@style/AppTheme">

        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <meta-data android:name="androidx.car.app.theme" android:resource="@style/CarAppTheme" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="3" />

        <!-- configChanges: rotation and density changes are handled in-process so the WebView is
             not destroyed and rebuilt from saved state on every configuration change.
             adjustResize: the IME inset is applied to the content container only (see
             BrowserActivity), so the keyboard never moves the toolbar or the page under it. -->
        <activity android:name=".browser.BrowserActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode|fontScale"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".entertainment.EntertainmentActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- TV, Radio, Folders, Playlists, Gallery and Favorites for the phone home grid. -->
        <activity android:name=".library.LibraryActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Phone playback for library/IPTV content. configChanges: rotation is handled in-process
             so the video SurfaceView is not torn down and re-created on every orientation change,
             which would drop the decoder attachment mid-stream. -->
        <activity android:name=".library.PlayerActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode|fontScale" />

        <!-- Step-by-step permissions and car-connection options. -->
        <activity android:name=".mirror.MirrorSetupActivity" android:exported="false" />

        <!-- Brings the media session up when a car connects; inert unless the option is on. -->
        <receiver android:name=".media.MediaAutoStart$BluetoothReceiver" android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <!-- SponsorBlock and auto-quality toggles for the in-app browser's YouTube pages. -->
        <activity android:name=".youtube.YouTubeSettingsActivity" android:exported="false" />

        <!-- Weather home tile: pick a place and see its current conditions (Open-Meteo, no key). -->
        <activity android:name=".weather.WeatherActivity" android:exported="false" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".mirror.ProjectionService" android:exported="false" android:foregroundServiceType="mediaProjection" />

        <!-- Exported so Android Auto / system media controllers can bind, per Media3's own
             MediaSessionService pattern. Access control is enforced per-controller inside
             MediaSession (see MediaPlaybackService), not by a manifest permission — a custom
             permission here would also block the legitimate system controllers this needs to
             stay reachable to. -->
        <service android:name=".media.MediaPlaybackService" android:exported="true" android:foregroundServiceType="mediaPlayback" tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <service android:name=".input.AutoBridgeAccessibilityService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service_config" />
        </service>

        <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="${applicationId}.shizuku" android:multiprocess="false" android:enabled="true" android:exported="true" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service android:name=".car.AutoBridgeCarAppService" android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

    </application>
</manifest>
