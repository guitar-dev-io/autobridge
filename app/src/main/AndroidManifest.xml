<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required by Shizuku's pre-v11 (ADB-server) permission-request flow; without it,
         RequestPermissionActivity in the Shizuku/Shizuku-Next manager fails to launch with
         SecurityException: Permission Denial. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- Only so the ACL_CONNECTED broadcast is delivered: from Android 12 it is permission
         protected, and the media auto-start option would otherwise be a switch that does nothing.
         No device is read and nothing is scanned for. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Special permission: granted via ACTION_MANAGE_WRITE_SETTINGS, used only for the
         per-app force-landscape profile (QuickAppLauncher). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Lets the Car setup screen show Android's own "Allow background activity" prompt directly
         instead of sending the user hunting through Settings. Some OEM battery managers
         (MIUI/HyperOS and similar) kill AutoBridge's foreground mirroring/media services anyway
         unless the app is exempted, even though both are declared and started correctly. Optional
         step — mirroring and playback still work without it on stock Android. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android for Cars: development/personal-use POC surface. -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />

    <!-- Optional GPS speed fallback for the speed display (best-value selection: CAR > GPS > OBD).
         Requested at runtime only when the user opts into GPS speed; not required for the app. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Read-only access for the Folders, Playlists and Gallery sections. Requested at runtime
         when the user opens one of those sections; the app works without them otherwise. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Voice commands on the car Agent screen (CarVoiceInput): the car microphone through
         CarAudioRecord, or the phone microphone as a fallback. Requested at runtime only when the
         user starts listening; nothing is recorded outside a listen session. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <!-- Package visibility for SpeechRecognizer.isRecognitionAvailable and TextToSpeech on
             Android 11+; without these both report no service even when one is installed. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- IPTV portals and set-top playlists are overwhelmingly plain http, so cleartext has to be
         permitted for user-entered hosts. The network security config keeps that explicit and
         reviewable instead of hiding it behind a blanket attribute. -->
    <!-- Backup stays on, minus the IPTV credential files: the rules below keep
         autobridge_iptv_sources.xml and autobridge_iptv_history.xml out of the cloud
         backup, because both hold provider usernames and passwords in the clear.
         See res/xml/data_extraction_rules.xml. -->
    <application android:name=".AutoBridgeApplication" android:networkSecurityConfig="@xml/network_security_config" android:allowBackup="true" android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="@xml/backup_rules" android:icon="@mipmap/ic_launcher" android:label="@string/app_name" android:localeConfig="@xml/locales_config" android:roundIcon="@mipmap/ic_launcher_round" android:supportsRtl="true" android:theme="@style/AppTheme">

        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />

        <!-- Hands a downloaded update APK to the installer the user picks (UpdateDownloader).
             Not exported; access is granted per file, to the chosen app only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
        <meta-data android:name="androidx.car.app.theme" android:resource="@style/CarAppTheme" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="3" />

        <!-- Two routes onto the head unit, kept side by side on purpose.
             AutoBridgeCarAppService paints the template UI into a Surface the host owns; this
             activity runs as a real window on the Android Auto display. Only the activity route
             gets a hardware-accelerated WebView, because nothing is captured and re-drawn - the
             system composites it like any other window. That is what removes the white bands the
             software canvas leaves while the page scrolls, and it is also the route on which
             Widevine works at all.

             This activity is no longer listed in the car launcher (no CAR_LAUNCHER category, see
             the intent-filter below - Play does not accept it alongside the
             com.google.android.gms.car.application meta-data). The template route through
             AutoBridgeCarAppService is the entry point on the head unit.

             resizeableActivity + <layout gravity="fill"> + maxAspectRatio: the car panel is a
             different size, density and aspect from the phone. Without all three the window is
             sized for the phone's aspect and letterboxed into the display instead of filling it.

             exported: external callers (car host, other apps) may start it. The only thing it takes from an
             intent is a URL, and ContentAddress.https filters that to HTTPS (see onNewIntent), so
             the exposure is the same any browser has.

             configChanges: rotation and density changes are handled in-process so the WebView is
             not destroyed and rebuilt from saved state on every configuration change - moving
             between the phone and the car display is exactly such a change.
             adjustResize: the IME inset is applied to the content container only (see
             BrowserActivity), so the keyboard never moves the toolbar or the page under it. -->
        <activity android:name=".browser.BrowserActivity" android:exported="true"
            android:resizeableActivity="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:maxAspectRatio="5.0"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <!-- No android.intent.category.LAUNCHER: this entry must not add a second icon to the
                 phone's launcher.
                 No android.intent.category.CAR_LAUNCHER either: Google Play rejects an app that
                 declares a CAR_LAUNCHER activity together with the
                 com.google.android.gms.car.application meta-data. The meta-data is what makes
                 AutoBridgeCarAppService (the Android Auto route) visible, so that one stays and
                 the activity is no longer advertised to the car launcher. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <category android:name="android.intent.category.APP_MAPS" />
            </intent-filter>
            <layout android:gravity="fill" android:minWidth="1dp" android:minHeight="1dp"
                android:defaultWidth="800dp" android:defaultHeight="480dp" />
            <meta-data android:name="distractionOptimized" android:value="true" />
            <meta-data android:name="android.max_aspect" android:value="5.0" />
        </activity>

        <activity android:name=".entertainment.EntertainmentActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Media bridge: "Share to AutoBridge".

             Transparent and no-history on purpose. The user is sharing from another app and
             should land back in it; a task left in Recents showing a blank AutoBridge screen is
             the usual cost of getting this wrong. excludeFromRecents + noHistory together mean
             the activity exists only for the length of one intent.

             exported, because being a share target is the entire point. What it accepts is text
             and http(s) links, and the only thing it does with either is hand it to
             ShareIntake/ContentRouter — the same filtering BrowserActivity's VIEW path already
             applies. -->
        <activity android:name=".bridge.ShareToCarActivity" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:label="@string/bridge_share_target_label">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- "Open with AutoBridge" on a link, which is how a browser hands one over when the
                 share sheet is not involved. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
            </intent-filter>
        </activity>

        <!-- TV, Radio, Folders, Playlists, Gallery and Favorites for the phone home grid. -->
        <activity android:name=".library.LibraryActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Phone playback for library/IPTV content. configChanges: rotation is handled in-process
             so the video SurfaceView is not torn down and re-created on every orientation change,
             which would drop the decoder attachment mid-stream. -->
        <!-- supportsPictureInPicture: the "Automatic picture in picture" video setting shrinks the
             player into a floating window when the screen is left. PiP delivers the change as a
             configuration change, which the same configChanges list already keeps in-process. -->
        <activity android:name=".library.PlayerActivity" android:exported="false"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode|fontScale" />

        <!-- Video settings for the player above, and its enhancement sub-screen. -->
        <activity android:name=".library.VideoSettingsActivity" android:exported="false" />
        <activity android:name=".library.VideoEnhancementActivity" android:exported="false" />
        <!-- On-device subtitle translation settings and Opus-MT model management. -->
        <activity android:name=".library.SubtitleSettingsActivity" android:exported="false" />
        <!-- Clear cache / reset app data. -->
        <activity android:name=".library.StorageSettingsActivity" android:exported="false" />

        <!-- Step-by-step permissions and car-connection options. -->
        <activity android:name=".mirror.MirrorSetupActivity" android:exported="false" />

        <!-- Brings the media session up when a car connects; inert unless the option is on. -->
        <receiver android:name=".media.MediaAutoStart$BluetoothReceiver" android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Runtime safety-bypass control. exported so the notification actions, the Settings
             toggle and an `adb shell am broadcast` all drive the same store. Only flips a local
             preference; reads no device data. -->
        <receiver android:name=".safety.BypassControlReceiver" android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="dev.autobridge.BYPASS_ON" />
                <action android:name="dev.autobridge.BYPASS_OFF" />
                <action android:name="dev.autobridge.BYPASS_TOGGLE" />
            </intent-filter>
        </receiver>

        <!-- SponsorBlock and auto-quality toggles for the in-app browser's YouTube pages. -->
        <activity android:name=".youtube.YouTubeSettingsActivity" android:exported="false" />

        <!-- Weather home tile: pick a place and see its current conditions (Open-Meteo, no key). -->
        <activity android:name=".weather.WeatherActivity" android:exported="false" />

        <!-- Settings > About > Open-source licenses. The Play-services viewer is an AppCompat
             activity; under the app's framework Material theme it crashes on launch
             ("You need to use a Theme.AppCompat theme"), so it gets the dark AppCompat theme. -->
        <activity android:name="com.google.android.gms.oss.licenses.OssLicensesMenuActivity" android:theme="@style/Theme.AppCompat" />
        <activity android:name="com.google.android.gms.oss.licenses.OssLicensesActivity" android:theme="@style/Theme.AppCompat" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".mirror.ProjectionService" android:exported="false" android:foregroundServiceType="mediaProjection" />

        <!-- Exported so Android Auto / system media controllers can bind, per Media3's own
             MediaSessionService pattern. Access control is enforced per-controller inside
             MediaSession (see MediaPlaybackService), not by a manifest permission — a custom
             permission here would also block the legitimate system controllers this needs to
             stay reachable to.
             android.media.browse.MediaBrowserService is what Android Auto looks for to list the
             app as a media source and give it the media card in the split dashboard, next to the
             navigation panel. -->
        <service android:name=".media.MediaPlaybackService" android:exported="true" android:foregroundServiceType="mediaPlayback" tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <service android:name=".input.AutoBridgeAccessibilityService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service_config" />
        </service>

        <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="${applicationId}.shizuku" android:multiprocess="false" android:enabled="true" android:exported="true" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service android:name=".car.AutoBridgeCarAppService" android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

    </application>
</manifest>
